# Mirevion SaaS — Variáveis de ambiente de desenvolvimento
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=mirevion
POSTGRES_USER=mirevion
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://mirevion:change-me@localhost:5432/mirevion

REDIS_URL=redis://localhost:6379/0

MINIO_ROOT_USER=mirevion
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=mirevion-dev
MINIO_ENDPOINT=localhost:9000

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
