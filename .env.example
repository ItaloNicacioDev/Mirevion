# Mirevion — Variáveis de ambiente de desenvolvimento
# Copie este arquivo para .env e preencha os valores reais.
# NÃO comite o .env com senhas ou segredos reais.

# --- Django / SaaS ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=sua-chave-secreta-desenvolvimento
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Banco de dados ---
POSTGRES_DB=mirevion
POSTGRES_USER=mirevion
POSTGRES_PASSWORD=sua-senha-do-postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://mirevion:sua-senha-do-postgres@localhost:5432/mirevion

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO ---
MINIO_ROOT_USER=mirevion
MINIO_ROOT_PASSWORD=sua-senha-do-minio
MINIO_BUCKET=mirevion-dev
MINIO_ENDPOINT=localhost:9000

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- JWT / Autenticação ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- CORS / CSFR ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000
